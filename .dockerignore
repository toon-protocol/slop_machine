# Keep the Docker build context lean and reproducible. node_modules and dist are
# rebuilt inside the image; .git/CI artifacts are never needed at build time.
**/node_modules
**/dist
.git
.github
**/*.tsbuildinfo
**/coverage
**/data
# Generated media only — the origin's own segmenter source is src/segmenter/,
# which must not be excluded from the build context.
**/segments
**/recordings
*.log
