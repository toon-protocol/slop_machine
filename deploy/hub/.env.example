# Copy to .env and fill in. Only the first four are required.
#
# Nothing here configures the CONNECTOR: it has no environment-variable layer,
# so every connector value — including the price of a quote and the price of a
# slot — lives in ./connector.toml, and its keys are FILES you generate next
# to it (README step 2).
#
# ONE SECRET LIVES HERE and it is RELAY_NOSTR_SECRET_KEY, because the relay
# image takes its identity as an environment value and offers no file-valued
# form. Everything else this bundle holds is a MOUNTED FILE, deliberately: an
# environment variable is visible to anything that can read /proc, shows up in
# `docker inspect`, and ends up in shell history on the way in. Neither of the
# hub's two operator credentials is here, and neither may be.

# ── Required ─────────────────────────────────────────────────────────────────
# The public hostname of the connector's client edge — where a broadcaster's
# paid quote and paid buy land, and a controller's paid announcement.
EDGE_HOST=hub.example.com
# The public hostname of the relay's free NIP-01 WebSocket reads — where a
# viber finds a station. Being found is free; being reachable is the slot.
READ_HOST=announce.hub.example.com
# Where Let's Encrypt sends certificate-expiry notices.
ACME_EMAIL=you@example.com
# The relay's own Nostr IDENTITY — not money, and not the connector's keys.
# Generate: openssl rand -hex 32
# Keep it stable: it is the pubkey every viber's client knows this hub by.
RELAY_NOSTR_SECRET_KEY=

# ── The hub's own address ────────────────────────────────────────────────────
# The ILP apex this hub answers to, and therefore the root of every prefix it
# grants: a broadcaster is granted `<this>.<their handle>`.
#
# KEEP THIS IN STEP WITH ./connector.toml. The four routes there are written
# beneath this address and `[node].addresses` lists them; the slot app derives
# every prefix it grants from this value. A hub whose app and connector
# disagree about its own address grants prefixes nothing terminates and writes
# routes nobody addresses. Change one and change the other in the same commit.
HUB_ADDRESS=g.toon.slopmachine

# ── The admission policy ─────────────────────────────────────────────────────
# Admission is a PRICE, not a judgement, so these numbers are the whole policy
# and changing one is never a code change. Placeholders from
# ../../docs/placeholder-numbers.md, in the settlement token's smallest unit
# (6-decimal USDC, so 1000000 is about $1.00).
#
# HUB_SLOT_PRICE and the BUY route's price in ./connector.toml are ONE PAIR.
# The connector is what charges; this is what the quote reports and the floor
# the app checks the connector's own stated X-TOON-Amount against, so a route
# misconfigured to under-charge cannot sell slots below policy.
HUB_SLOT_PRICE=1000000

# How long a slot lasts before it lapses. SECONDS — which is what makes a
# lapse testable without a fake clock — so 2592000 is thirty days. Buying
# again extends from the lapse you already hold rather than resetting to now,
# so renewing early costs you nothing.
HUB_SLOT_PERIOD_SECONDS=2592000

# THE HUB'S CAPITAL BOUND, and the number you are most likely to change first.
# Every admission opens a payment channel this hub fronts collateral toward,
# so the roster is a balance-sheet commitment and this is the only thing
# bounding it — at the placeholder collateral figure a full roster is about
# $5,000 committed. `0` is a legal setting and means this hub is admitting
# nobody; the quote says so at its own cheap address rather than the buy
# refusing at the expensive one. Lowering it below your own roster closes the
# door without evicting the stations behind it: a renewal is never refused for
# the cap.
HUB_SLOT_CAP=100

# How often the roster is walked for slots past their lapse time. This is the
# GRANULARITY of the lapse, not its length. There is deliberately no value
# that turns the sweep off, and `0` is refused at boot: a hub that never
# reclaims a dead station's peering only ever commits more collateral.
HUB_LAPSE_SWEEP_SECONDS=60

# ── The peering policy: this hub's terms about a counterparty ────────────────
# What this hub retains for carrying one packet onward to a station it
# admitted. CARRIAGE IS WHERE A HUB EARNS — the slot price exists to make
# admission self-service and to lapse dead stations, not to be revenue — and
# it is what has to cover the collateral every admission fronts.
#
# Each route the app writes is priced at the station's own published price
# PLUS this. That sum is arithmetic, not policy: the station's connector
# checks per packet that a peer-wire arrival covers its own termination price,
# so a hub route priced any lower is reachable, paid for, and dead.
HUB_PEERING_FEE=20

# The largest amount this hub will forward in one packet. It has to sit above
# the most expensive thing any station it admits sells — 3500 on the
# placeholder ladder — or the hub is peered with a station whose top rung
# nobody can pay for.
HUB_PEERING_MAX_PACKET_AMOUNT=10000000

# ── Images ───────────────────────────────────────────────────────────────────
# The two app images this hub runs, both on `:release`, which moves on every
# green merge to each app's own main and is what the Watchtower overlay
# follows. Pin an immutable `:sha-<short>` tag here to hold a specific build
# or roll one back.
#
# The slot app is THIS repository's; the relay is the relay repository's and
# this repo publishes none of it.
SLOT_APP_IMAGE=ghcr.io/toon-protocol/slot-app:release
RELAY_IMAGE=ghcr.io/toon-protocol/relay:release

# The CONNECTOR is deliberately NOT settable here: it is pinned to an
# immutable tag directly in ./docker-compose.yml, next to the connector.toml
# it was validated against, so the two move in one reviewed commit and reach
# the box in one `git pull`. Adopting a newer connector means editing that
# `image:` line — one of exactly two places in this repository a connector
# build may be named, the other being the station bundle's.

# ── The relay ────────────────────────────────────────────────────────────────
# true skips event-signature verification on writes. Smoke tests only.
RELAY_DEV_MODE=false
# true restores full schnorr verification for paid ephemeral kinds
# (20000-29999). The default false skips it, which is safe only because the
# relay's write port is reachable exclusively through the connector — see
# docker-compose.yml's ports invariant. Set true if you ever front it
# otherwise.
RELAY_VERIFY_EPHEMERAL=false
# Max concurrent WebSocket read connections (one file descriptor each).
RELAY_MAX_CONNECTIONS=4096
# Retention: an event past its own NIP-40 `expiration` stops being served and
# is deleted after the grace window. false is the kill switch — set it,
# restart, and every still-stored announcement is served again, which works
# only while the data is still on disk, hence the grace.
RELAY_ENFORCE_EXPIRATION=true
RELAY_EXPIRATION_REAP_GRACE_SECONDS=86400
RELAY_EXPIRATION_REAP_INTERVAL_SECONDS=3600
# Free ephemeral write lane bounds. That lane has no payment gate, so these
# ARE its admission control.
RELAY_EPHEMERAL_RATE_LIMIT=200
RELAY_EPHEMERAL_RATE_WINDOW_MS=10000
RELAY_EPHEMERAL_MAX_BODY_BYTES=8192
