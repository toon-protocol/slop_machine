[Unit]
Description=Apply the merged slop machine station bundle (fast-forward, compose up)
Documentation=https://github.com/toon-protocol/slop_machine/blob/main/deploy/README.md
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/root/slop_machine/deploy/auto-apply.sh
# The script takes its own flock; this only stops systemd stacking runs.
TimeoutStartSec=600
