{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true
  },
  // packages/guide is a browser SPA — JSX and DOM libs its siblings must not
  // inherit — so it is excluded here and typechecked through its own
  // tsconfig, which the root typecheck script chains.
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "deploy/devnet/run",
    "packages/guide"
  ]
}
