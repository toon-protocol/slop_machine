{
  "name": "slop-machine",
  "version": "0.1.0",
  "private": true,
  "description": "Paid live broadcast over TOON: the station origin and the slot app",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:image": "vitest run --config vitest.image.config.ts",
    "test:devnet": "vitest run --config vitest.devnet.config.ts",
    "test:guide": "bash packages/guide/e2e/run.sh",
    "demo": "vite-node deploy/devnet/demo.ts --",
    "demo:viewer": "vite-node deploy/devnet/viewer.ts --",
    "lint": "eslint .",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/e2e/**/*.ts\" \"deploy/*.ts\" \"deploy/hub/*.ts\" \"deploy/devnet/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/e2e/**/*.ts\" \"deploy/*.ts\" \"deploy/hub/*.ts\" \"deploy/devnet/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/guide/tsconfig.json --noEmit"
  },
  "keywords": [
    "toon",
    "hls",
    "rtmp",
    "broadcast",
    "ilp"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@toon-protocol/client": "3.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "nostr-tools": "2.25.2",
    "prettier": "^3.2.0",
    "smol-toml": "^1.7.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "viem": "^2.56.3",
    "vite-node": "^3.2.4",
    "vitest": "^3.0.0",
    "yaml": "^2.9.0"
  }
}
