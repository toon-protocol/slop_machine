{
  "name": "slop-machine",
  "version": "0.1.0",
  "private": true,
  "description": "Paid live broadcast over TOON: the station origin and the slot app",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:image": "vitest run --config vitest.image.config.ts",
    "lint": "eslint .",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"deploy/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"deploy/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "toon",
    "hls",
    "rtmp",
    "broadcast",
    "ilp"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.2.0",
    "smol-toml": "^1.7.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.0"
  }
}
